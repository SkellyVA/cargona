#!/usr/bin/env bash
# ==============================================================================
# CargonaOS — Unified Server Administration CLI
# Usage: ./cargona [command] or run interactively: ./cargona
# ==============================================================================

set -e
umask 077

SCRIPT_PATH="${BASH_SOURCE[0]}"
if [ -L "$SCRIPT_PATH" ]; then
  SCRIPT_PATH="$(readlink -f "$SCRIPT_PATH")"
fi
APP_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
if [ ! -f "${APP_DIR}/docker-compose.yml" ] && [ -d "/opt/cargona" ]; then
  APP_DIR="/opt/cargona"
fi
cd "$APP_DIR"

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

ENV_FILE="${APP_DIR}/.env"
BACKUP_DIR="${APP_DIR}/data/backups"
STORE_FILE="${APP_DIR}/data/backend/cargona-store.json"
if [ ! -f "$STORE_FILE" ] && [ -f "${APP_DIR}/cargona-store.json" ]; then
  STORE_FILE="${APP_DIR}/cargona-store.json"
fi

mkdir -p "$BACKUP_DIR"

# Helper to read .env variable
get_env_var() {
  local var_name="$1"
  if [ -f "$ENV_FILE" ]; then
    local value
    value="$(grep -m 1 "^${var_name}=" "$ENV_FILE" | cut -d '=' -f2- | tr -d '\r' || true)"
    if [[ "$value" == \'*\' ]]; then value="${value:1:${#value}-2}"; value="${value//\\\'/\'}";
    elif [[ "$value" == \"*\" ]]; then value="${value:1:${#value}-2}"; fi
    printf '%s\n' "$value"
  fi
}

# Helper to set/update .env variable
set_env_var() {
  local var_name="$1"
  local var_value="$2"
  [[ "$var_name" =~ ^[A-Z_][A-Z0-9_]*$ && "$var_value" != *$'\n'* && "$var_value" != *$'\r'* ]] || return 1
  local temp line
  temp="$(mktemp "$APP_DIR/.env-XXXXXX")"
  if [[ -f "$ENV_FILE" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" == "$var_name="* ]] || printf '%s\n' "$line" >>"$temp"
    done <"$ENV_FILE"
  fi
  # Single-quoted dotenv values disable variable interpolation.
  var_value="${var_value//\'/\\\'}"
  printf "%s='%s'\n" "$var_name" "$var_value" >>"$temp"
  chmod 600 "$temp"
  mv "$temp" "$ENV_FILE"
}

# Docker compose command wrapper
dc_cmd() {
  local files=(-f "${APP_DIR}/docker-compose.yml")
  [ ! -f "${APP_DIR}/data/releases/active.yml" ] || files+=(-f "${APP_DIR}/data/releases/active.yml")
  if docker compose version &> /dev/null; then
    docker compose --project-directory "$APP_DIR" "${files[@]}" "$@"
  else
    docker-compose --project-directory "$APP_DIR" "${files[@]}" "$@"
  fi
}

# 1. STATUS
cmd_status() {
  echo -e "\n${BLUE}================================================================${NC}"
  echo -e "${BOLD}              Статус системы CargonaOS${NC}"
  echo -e "${BLUE}================================================================${NC}"
  
  local domain=$(get_env_var "APP_DOMAIN")
  local email=$(get_env_var "SUPERADMIN_EMAIL")
  local limit=$(get_env_var "MAX_TENANTS_LIMIT")
  [ -z "$limit" ] && limit="0"

  echo -e "🌐 ${BOLD}Домен:${NC}               https://${domain:-cargona.local}"
  echo -e "📧 ${BOLD}Супер-Админ:${NC}         ${email:-admin@cargona.io}"
  if [ "$limit" -gt 0 ] 2>/dev/null; then
    echo -e "🏢 ${BOLD}Лимит организаций:${NC}   ${limit} (Ограничено лицензией)"
  else
    echo -e "🏢 ${BOLD}Лимит организаций:${NC}   Безлимит (SaaS Platform)"
  fi
  echo -e "${BLUE}----------------------------------------------------------------${NC}"
  echo -e "${BOLD}Статус Docker контейнеров:${NC}\n"
  dc_cmd ps
  echo ""
}

# 2. ADMIN PASSWORD & EMAIL RESET
cmd_reset_admin() {
  read -r -p 'Сброс: 1 — Супер-Админ, 2 — владелец компании [1]: ' kind
  read -r -p 'Email: ' email
  read -r -s -p 'Новый пароль (12+ символов): ' password; printf '\n'
  read -r -s -p 'Повторите пароль: ' repeated; printf '\n'
  [[ ${#password} -ge 12 && "$password" == "$repeated" && "$password" != *$'\r'* ]] || { echo 'Пароли должны совпадать, минимум 12 символов' >&2; return 1; }
  [[ "$email" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || { echo 'Invalid email' >&2; return 1; }
  if [[ "${kind:-1}" == 2 ]]; then
    read -r -p 'Slug компании: ' slug
    printf '%s\0%s\0%s' "$slug" "$email" "$password" |
      dc_cmd run --rm --no-deps --pull never -T --entrypoint node backend -e '
        let input="";process.stdin.on("data",b=>input+=b).on("end",()=>{
          const [slug,email,password]=input.split("\0");console.log(JSON.stringify({slug,email,password}));});' |
      bash "$APP_DIR/maintenance.sh" owner-reset
  else
    set_env_var SUPERADMIN_EMAIL "$email"
    set_env_var SUPERADMIN_PASSWORD "$password"
    dc_cmd up -d --no-deps --no-build --pull never backend
    echo 'Учетные данные Супер-Админа обновлены. Пароль не выводится в журнал.'
  fi
}
# 3. CHANGE TENANTS LIMIT
cmd_set_limit() {
  echo -e "\n${CYAN}=== Изменение лимита организаций (Лицензия) ===${NC}"
  local current_limit=$(get_env_var "MAX_TENANTS_LIMIT")
  [ -z "$current_limit" ] && current_limit="0"

  echo -e "Текущий лимит: ${BOLD}${current_limit}${NC} (0 = безлимит, 1 = Single-Tenant)"
  read -p "Введите новый лимит [${current_limit}]: " new_limit
  new_limit=${new_limit:-$current_limit}
  [[ "$new_limit" =~ ^[0-9]+$ ]] || { echo 'Лимит должен быть целым неотрицательным числом' >&2; return 1; }

  set_env_var "MAX_TENANTS_LIMIT" "$new_limit"

  echo -e "${CYAN}Применение нового лимита...${NC}"
  dc_cmd up -d --no-deps --no-build --pull never backend

  if [ "$new_limit" -gt 0 ] 2>/dev/null; then
    echo -e "${GREEN}✓ Лимит успешно установлен: ${BOLD}максимум ${new_limit} организаций${NC}.\n"
  else
    echo -e "${GREEN}✓ Лимит успешно снят: ${BOLD}полный безлимит (SaaS)${NC}.\n"
  fi
}

# 4. BACKUP CREATE
cmd_backup_create() {
  [[ -f "$APP_DIR/release.sh" ]] || { echo 'Скрипт проверенного бэкапа отсутствует. Сначала обновите CLI через tools:update.' >&2; return 1; }
  bash "$APP_DIR/release.sh" backup
}

# 5. BACKUP RESTORE
cmd_backup_restore() (
  if [ -f "${APP_DIR}/release.sh" ]; then
    mkdir -p "${APP_DIR}/data/releases"
    exec 8>"${APP_DIR}/data/releases/.lock"
    flock -n 8 || { echo 'Другой процесс обновления или восстановления уже работает.' >&2; return 1; }
    local selected_mode
    selected_mode="$(bash "${APP_DIR}/release.sh" mode)" || return 1
    if [ "$selected_mode" = postgres ]; then
      echo 'PostgreSQL: восстановление требует отдельной проверки pg_restore. JSON-бэкап не заменяет PostgreSQL.' >&2
      return 1
    fi
    STORE_FILE="$(bash "${APP_DIR}/release.sh" data-path)" || return 1
  fi
  echo -e "\n${CYAN}=== Восстановление базы данных из бэкапа ===${NC}"
  local backups=()
  while IFS= read -r bkp; do backups+=("$bkp"); done < <(find "$BACKUP_DIR" "${APP_DIR}/data/releases" -type f -name '*.json' 2>/dev/null | sort -r)

  if [ ${#backups[@]} -eq 0 ]; then
    echo -e "${RED}[!] В папке ${BACKUP_DIR} нет сохраненных бэкапов.${NC}\n"
    return
  fi

  echo -e "Доступные резервные копии:"
  local idx=1
  for bkp in "${backups[@]}"; do
    local fname=$(basename "$bkp")
    local size=$(ls -lh "$bkp" | awk '{print $5}')
    echo -e "  ${BOLD}[$idx]${NC} $fname ($size)"
    idx=$((idx + 1))
  done

  read -p "Выберите номер бэкапа для восстановления [1-${#backups[@]}]: " choice
  if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#backups[@]}" ]; then
    echo -e "${RED}[!] Неверный выбор.${NC}\n"
    return
  fi

  local selected_bkp="${backups[$((choice - 1))]}"
  if [ -f "$(dirname "$selected_bkp")/checksum" ]; then
    (cd "$(dirname "$selected_bkp")" && sha256sum --check checksum >/dev/null) || return 1
  fi
  dc_cmd run --rm --no-deps -v "$(dirname "$selected_bkp"):/snapshot:ro" --entrypoint node backend -e '
    try {const s=JSON.parse(require("fs").readFileSync("/snapshot/"+process.argv[1],"utf8"));
    if(!s || typeof s!=="object" || Array.isArray(s) || ("storageFormat" in s && s.storageFormat!=="cargona-state-v1") ||
      !["tenants","customers","packages","users"].every(k=>Array.isArray(s[k])))process.exit(1);
    } catch {console.error("Snapshot validation failed");process.exit(1);}' "$(basename "$selected_bkp")" || return 1
  echo -e "${YELLOW}[!] ВНИМАНИЕ: Текущая база данных будет заменена на копию: $(basename "$selected_bkp")${NC}"
  read -p "Вы уверены? (y/n): " confirm
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    echo -e "Восстановление отменено.\n"
    return
  fi

  # Stop api to safely write file
  echo -e "${CYAN}Восстановление данных...${NC}"
  dc_cmd stop backend
  local safety_copy
  safety_copy="$(mktemp --suffix=.json "${BACKUP_DIR}/before_restore_$(date +%Y%m%d_%H%M%S)_XXXXXX")"
  cp "$STORE_FILE" "$safety_copy"
  sync "$safety_copy"
  local restore_tmp
  restore_tmp="$(mktemp "$(dirname "$STORE_FILE")/.cargona-restore.XXXXXX")"
  cp "$selected_bkp" "$restore_tmp"
  sync "$restore_tmp"
  mv "$restore_tmp" "$STORE_FILE"
  dc_cmd start backend
  local restore_ready=false
  for attempt in {1..30}; do
    if dc_cmd exec -T backend node -e '
      fetch("http://127.0.0.1:4000/health/ready",{signal:AbortSignal.timeout(3000)})
        .then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1));'; then restore_ready=true; break; fi
    sleep 2
  done
  if [ "$restore_ready" != true ]; then echo 'Проверка API не прошла. Сохранена копия до восстановления.' >&2; return 1; fi

  echo -e "\n${GREEN}${BOLD}✓ База данных успешно восстановлена!${NC}\n"
)

# 6. UPDATE SYSTEM
cmd_update() {
  if [ -f "${APP_DIR}/update.sh" ]; then
    local target="${1:-}"
    if [ -z "$target" ]; then target="$(bash "$APP_DIR/version-select.sh")" || return 1; fi
    bash "${APP_DIR}/update.sh" "$target"
  else
    echo 'Безопасный updater не установлен. Обновление не выполнено.' >&2
    return 1
  fi
}

# 7. RESTART SERVICES
cmd_restart() {
  echo -e "\n${CYAN}Перезапуск всех сервисов CargonaOS...${NC}"
  dc_cmd restart
  echo -e "${GREEN}✓ Все контейнеры успешно перезапущены.${NC}\n"
}

# 8. CHANGE DOMAIN & SSL
cmd_domain() {
  echo -e "\n${CYAN}=== Смена домена и перевыпуск SSL ===${NC}"
  local current_domain=$(get_env_var "APP_DOMAIN")
  read -p "Введите новый домен [${current_domain}]: " new_dom
  new_dom=${new_dom:-$current_domain}
  new_dom=$(echo "$new_dom" | sed -e 's|^https://||' -e 's|^http://||' -e 's|/$||')
  [[ "$new_dom" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]+[a-zA-Z0-9]$ ]] || { echo 'Укажите корректный домен' >&2; return 1; }

  set_env_var "APP_DOMAIN" "$new_dom"

  echo -e "${CYAN}Перезапуск веб-сервера и перевыпуск SSL-сертификата...${NC}"
  dc_cmd up -d --no-deps --no-build --pull never caddy backend
  echo -e "\n${GREEN}✓ Домен изменен на: https://${new_dom}${NC}"
  echo -e "🔒 SSL-сертификат будет автоматически активирован при переходе.\n"
}

# 10. LOYALTY & REFERRAL PROGRAM (NOOR CLUB)
cmd_loyalty() {
  echo -e "\n${CYAN}=== Программа лояльности и реферальная система (NOOR CLUB) ===${NC}"
  local current_status=$(get_env_var "ENABLE_NOOR_CLUB")
  local allowed_tenants=$(get_env_var "ALLOWED_LOYALTY_TENANTS")
  [ -z "$allowed_tenants" ] && allowed_tenants=$(get_env_var "ENABLE_NOOR_CLUB_TENANTS")
  [ -z "$current_status" ] && current_status="false"

  local status_label="${YELLOW}ОТКЛЮЧЕН${NC}"
  if [ "$current_status" = "true" ]; then
    status_label="${GREEN}ВКЛЮЧЕН (глобально для всех)${NC}"
  elif [ -n "$allowed_tenants" ]; then
    status_label="${GREEN}ВКЛЮЧЕН (выборочно для: ${allowed_tenants})${NC}"
  fi

  echo -e "Текущий статус модуля NOOR CLUB: ${BOLD}${status_label}${NC}"
  echo -e "Параметры по умолчанию:"
  echo -e "  • Спец. тариф: 26 сом/кг (после 2 активных друзей)"
  echo -e "  • Бонус: +10 сом за каждого следующего друга"
  echo -e "  • Списание: 1 сом скидки за 1 кг"
  echo -e "  • Мин. тариф: 25 сом/кг"
  echo -e ""
  echo -e "  ${BOLD}[1]${NC} Включить глобально для ВСЕХ организаций"
  echo -e "  ${BOLD}[2]${NC} Включить выборочно для конкретных организаций (slug через запятую)"
  echo -e "  ${BOLD}[3]${NC} Отключить полностью"
  read -p "Выберите вариант [1-3]: " l_choice

  if [ "$l_choice" = "1" ]; then
    set_env_var "ENABLE_NOOR_CLUB" "true"
    set_env_var "ALLOWED_LOYALTY_TENANTS" ""
    set_env_var "ENABLE_NOOR_CLUB_TENANTS" ""
    echo -e "${CYAN}Применение настроек к контейнеру бэкенда...${NC}"
    dc_cmd up -d --no-deps --no-build --pull never backend
    echo -e "\n${GREEN}✓ Программа лояльности NOOR CLUB успешно активирована для всех организаций!${NC}\n"
  elif [ "$l_choice" = "2" ]; then
    read -p "Введите slug организаций через запятую (например: prime,has): " t_slugs
    t_slugs=${t_slugs:-$allowed_tenants}
    set_env_var "ENABLE_NOOR_CLUB" "false"
    set_env_var "ALLOWED_LOYALTY_TENANTS" "$t_slugs"
    set_env_var "ENABLE_NOOR_CLUB_TENANTS" "$t_slugs"
    echo -e "${CYAN}Применение настроек к контейнеру бэкенда...${NC}"
    dc_cmd up -d --no-deps --no-build --pull never backend
    echo -e "\n${GREEN}✓ Программа лояльности NOOR CLUB активирована для организаций: ${BOLD}${t_slugs}${NC}\n"
  else
    set_env_var "ENABLE_NOOR_CLUB" "false"
    set_env_var "ALLOWED_LOYALTY_TENANTS" ""
    set_env_var "ENABLE_NOOR_CLUB_TENANTS" ""
    echo -e "${CYAN}Применение настроек к контейнеру бэкенда...${NC}"
    dc_cmd up -d --no-deps --no-build --pull never backend
    echo -e "\n${YELLOW}✓ Программа лояльности NOOR CLUB отключена.${NC}\n"
  fi
}

# 11. VIEW LOGS
cmd_logs() {
  local service="$1"
  if [ -n "$service" ]; then
    dc_cmd logs -f --tail 50 "$service"
  else
    dc_cmd logs -f --tail 30
  fi
}

# 12. INSTALL AS GLOBAL COMMAND
cmd_install_global() {
  if [ "$EUID" -eq 0 ]; then
    if [[ "$(readlink -f /usr/local/bin/cargona 2>/dev/null || true)" != "$APP_DIR/cargona" ]]; then
      ln -sf "${APP_DIR}/cargona" /usr/local/bin/cargona
      chmod +x /usr/local/bin/cargona
    fi
  fi
}

menu_screen() {
  if [[ -t 1 ]]; then clear 2>/dev/null || true; fi
  printf '\n============================================================\n  CargonaOS · %s\n============================================================\n\n' "$1"
}
menu_pause() { read -r -p 'Нажмите Enter, чтобы вернуться в меню...' _ || return 1; }
menu_run() {
  printf '\n------------------------------------------------------------\n'
  if bash "$APP_DIR/cargona" "$@"; then
    printf '\n✓ Операция завершена.\n'
  else
    printf '\nНе выполнено. Причина и дальнейшие действия указаны выше.\n'
  fi
  menu_pause
}
cmd_doctor() {
  local tool missing=false
  echo 'Проверка окружения (без установки и изменения настроек)'
  for tool in docker curl openssl flock sha256sum; do
    if command -v "$tool" >/dev/null; then printf '  ✓ %s\n' "$tool";
    else printf '  ✗ %s — не найден\n' "$tool"; missing=true; fi
  done
  if docker compose version >/dev/null 2>&1; then echo '  ✓ Docker Compose v2';
  else echo '  ✗ Docker Compose v2 недоступен'; missing=true; fi
  if docker info >/dev/null 2>&1; then echo '  ✓ Docker daemon доступен';
  else echo '  ✗ Docker daemon недоступен'; missing=true; fi
  if command -v restic >/dev/null; then restic version;
  else echo '  ○ Restic не установлен — нужен только для внешних копий (меню 14 → 11)'; fi
  if command -v systemctl >/dev/null && systemctl show --property=Version --value >/dev/null 2>&1; then echo '  ✓ systemd доступен';
  else echo '  ○ systemd недоступен — расписания не смогут работать'; fi
  [[ "$missing" == false ]]
}

# INTERACTIVE MENU
interactive_menu() {
  while true; do
    menu_screen 'Управление сервером'
    local domain=$(get_env_var "APP_DOMAIN")
    local limit=$(get_env_var "MAX_TENANTS_LIMIT")
    local loyalty=$(get_env_var "ENABLE_NOOR_CLUB")
    [ -z "$limit" ] && limit="0"
    [ -z "$loyalty" ] && loyalty="false"

    local limit_label="Безлимит"
    if [ "$limit" -gt 0 ] 2>/dev/null; then
      limit_label="$limit"
    fi
    local loyalty_label="Выкл"
    if [ "$loyalty" = "true" ]; then
      loyalty_label="Вкл"
    fi

    echo -e "🌐 Домен: ${BOLD}https://${domain:-cargona.local}${NC} | 🏢 Лимит: ${BOLD}${limit_label}${NC} | 🏆 Клуб: ${BOLD}${loyalty_label}${NC}"
    echo -e "${BLUE}================================================================${NC}"
    echo -e " ${BOLD}1)${NC} 📊 Статус системы и контейнеров"
    echo -e " ${BOLD}2)${NC} 🔑 Пароль и email супер-админа / владельца"
    echo -e " ${BOLD}3)${NC} 🏢 Изменить лимит организаций (Лицензия)"
    echo -e " ${BOLD}4)${NC} 💾 Создать резервную копию (Бэкап БД)"
    echo -e " ${BOLD}5)${NC} 🔄 Восстановить базу из бэкапа"
    echo -e " ${BOLD}6)${NC} 🚀 Выбрать версию и обновить приложение"
    echo -e " ${BOLD}7)${NC} 🔄 Перезапустить сервисы"
    echo -e " ${BOLD}8)${NC} 🌐 Сменить домен / перевыпустить SSL"
    echo -e " ${BOLD}9)${NC} 🏆 Настройки программы лояльности (NOOR CLUB)"
