    echo -e " ${BOLD}19)${NC} 🩺 Проверка зависимостей и окружения"
    echo -e " ${BOLD}0)${NC} 🚪 Выход"
    echo -e "${BLUE}================================================================${NC}"
    read -p "Выберите действие [0-19]: " choice || return

    case "$choice" in
      1) menu_run status || return;;
      2) menu_run admin:reset || return;;
      3) menu_run limit || return;;
      4) menu_run backup || return;;
      5) menu_run backup:restore || return;;
      6) menu_run update || return;;
      7) menu_run restart || return;;
      8) menu_run domain || return;;
      9) menu_run loyalty || return;;
      10)
        echo -e "\n${CYAN}=== Умный импорт данных в CargonaOS ===${NC}"
        read -p "Тип источника (1 - MongoDB URI, 2 - Папка с JSON файлами): " imp_type
        read -p "Slug организации (например: cargona, prime, noor): " imp_tenant
        imp_tenant=${imp_tenant:-cargona}
        read -p "Очистить старую базу тенанта перед импортом? (y/n) [n]: " imp_wipe_choice
        local wipe_flag=""
        if [[ "$imp_wipe_choice" =~ ^[Yy]$ ]]; then
          wipe_flag="--wipe"
          echo -e "${YELLOW}[!] Режим: Полная замена старой базы на новую${NC}"
        fi
        if [ "$imp_type" = "1" ]; then
          read -r -s -p "MongoDB URI (ввод скрыт): " imp_uri; printf '\n'
          menu_run import --mongo "$imp_uri" --tenant "$imp_tenant" $wipe_flag || return
        elif [[ "$imp_type" == 2 ]]; then
          read -p "Путь к папке с JSON (по умолчанию ./dumps): " imp_dir
          imp_dir=${imp_dir:-./dumps}
          menu_run import --dir "$imp_dir" --tenant "$imp_tenant" $wipe_flag || return
        else
          echo 'Выберите 1 — MongoDB или 2 — JSON'; menu_pause || return
        fi
        ;;
      11)
        read -r -p 'Сервис для логов (backend/frontend/bot/postgres; Enter — все): ' log_service
        menu_run logs "$log_service" || return;;
      12)
        bash "$APP_DIR/cargona" rollback:list || echo 'Не удалось получить список'
        read -r -p 'ID для отката (Enter — назад; актуальная база сохраняется): ' release_id
        if [[ -n "$release_id" ]]; then menu_run rollback "$release_id" || return; fi;;
      13)
        tools_sha="$(bash "$APP_DIR/version-select.sh")" || continue
        menu_run tools:update "$tools_sha" || return;;
      14) operations_menu offsite;;
      15) operations_menu monitor;;
      16)
        read -r -p 'Абсолютный путь к копии: ' snapshot_dir
        read -r -p 'Образ API (ghcr.io/skellyva/cargona-api:SHA): ' api_image
        menu_run rehearse "$snapshot_dir" "$api_image" || return;;
      17) operations_menu postgres;;
      18) bash "$APP_DIR/cargona" help; read -r -p 'Нажмите Enter...' ;;
      19) menu_run doctor || return;;
      0) echo -e "\nДо свидания!\n"; exit 0;;
      *) echo -e "${RED}Неверный пункт меню${NC}"; sleep 1;;
    esac
  done
}

# Helper to execute smart importer
run_importer() {
  bash "$APP_DIR/maintenance.sh" import "$@"
}
# Additional interactive menus use the same CLI routes as typed commands.
operations_menu() {
  local kind="$1" choice command argument
  while true; do
    argument=''
    case "$kind" in
      offsite)
        menu_screen 'Внешние резервные копии'
        if command -v restic >/dev/null; then echo '  Restic: установлен';
        else echo '  Restic: не установлен → пункт 11'; fi
        if [[ -f "$APP_DIR/data/offsite/restic.env" ]]; then echo '  Хранилище: настроено';
        else echo '  Хранилище: не настроено'; fi
        printf '\n  Первый запуск: 11 → 1 → 2 → 3 → 4\n\n'
        printf '   1) Настроить Backblaze B2 и шифрование\n   2) Инициализировать хранилище\n   3) Создать копию сейчас\n\n   4) Включить расписание (каждые 15 минут)\n   5) Отключить расписание\n   6) Статус и последние запуски\n\n   7) Список копий\n   8) Проверить целостность (может занять время)\n   9) Очистить старые копии по правилам хранения\n  10) Скачать копию в отдельный каталог\n  11) Установить Restic (Debian/Ubuntu)\n\n   0) Назад\n\n'
        read -r -p 'Выберите действие: ' choice || return
        case "$choice" in
          1) command=offsite:configure;; 2) command=offsite:init;; 3) command=offsite:run;;
          4) command=offsite:enable;; 5) command=offsite:disable;; 6) command=offsite:status;;
          7) command=offsite:list;; 8) command=offsite:check;; 9) command=offsite:prune;;
          10) read -r -p 'ID копии (рабочая база не заменяется): ' argument || return
              command=offsite:restore;;
          11) command=offsite:install-restic;;
          0) return;; *) echo 'Неверный пункт'; menu_pause || return; continue;;
        esac;;
      monitor)
        menu_screen 'Мониторинг и уведомления'
        if [[ -f "$APP_DIR/data/monitor/telegram.env" ]]; then echo '  Telegram: настроен'; else echo '  Telegram: не настроен'; fi
        printf '\n   1) Настроить отдельного бота и личный чат\n   2) Проверить систему сейчас\n   3) Включить проверки каждые 2 минуты\n   4) Отключить расписание\n   5) Статус мониторинга\n\n   0) Назад\n\n'
        read -r -p 'Выберите действие: ' choice || return
        case "$choice" in
          1) command=monitor:configure;; 2) command=monitor:run;; 3) command=monitor:enable;;
          4) command=monitor:disable;; 5) command=monitor:status;;
          0) return;; *) echo 'Неверный пункт'; menu_pause || return; continue;;
        esac;;
      postgres)
        menu_screen 'Миграция JSON → PostgreSQL'
        printf '  Проверка и репетиция не переключают рабочее хранилище.\n  Применение потребует подтверждения и остановит доступ.\n\n   1) Текущий режим хранения\n   2) Проверить исходный JSON\n   3) Пробная транзакция с откатом\n   4) Изолированная репетиция восстановления\n   5) Перенести данные и переключить API\n\n   0) Назад\n\n'
        read -r -p 'Выберите действие: ' choice || return
        case "$choice" in
          1) command=migration:status;; 2) command=migration:inspect;; 3) command=migration:trial;;
          4) command=migration:rehearse;; 5) command=migration:apply;;
          0) return;; *) echo 'Неверный пункт'; menu_pause || return; continue;;
        esac;;
    esac
    if [[ -n "$argument" ]]; then menu_run "$command" "$argument" || return;
    else menu_run "$command" || return; fi
  done
}

# CLI Router
cmd_install_global 2>/dev/null || true

case "$1" in
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  "admin:reset"|"admin:password") cmd_reset_admin ;;
  "license:limit"|"limit")
    if [ -n "$2" ]; then
      [[ "$2" =~ ^[0-9]+$ ]] || { echo 'Лимит должен быть целым неотрицательным числом' >&2; exit 1; }
      set_env_var "MAX_TENANTS_LIMIT" "$2"
      dc_cmd up -d --no-deps --no-build --pull never backend
      echo -e "${GREEN}✓ Лимит обновлен на: $2${NC}"
    else
      cmd_set_limit
    fi
    ;;
  loyalty|"club") cmd_loyalty ;;
  "backup:create"|"backup") cmd_backup_create ;;
  "backup:restore") cmd_backup_restore ;;
  offsite:*) bash "${APP_DIR}/offsite-backup.sh" "${1#offsite:}" "${@:2}" ;;
  monitor:*) bash "${APP_DIR}/monitor.sh" "${1#monitor:}" ;;
  rehearse) bash "${APP_DIR}/rehearse.sh" "${2:-}" "${3:-}" ;;
  "tools:update")
    tools_sha="${2:-}"
    if [[ -z "$tools_sha" ]]; then tools_sha="$(bash "$APP_DIR/version-select.sh")"; fi
    bash "${APP_DIR}/runtime-tools.sh" "$tools_sha" ;;
  migration:*) bash "${APP_DIR}/postgres-migrate.sh" "${1#migration:}" ;;
  update) cmd_update "${2:-}" ;;
  rollback) bash "${APP_DIR}/release.sh" rollback "${2:-}" ;;
  "rollback:list") bash "${APP_DIR}/release.sh" list ;;
  restart) cmd_restart ;;
  domain)
    if [ -n "$2" ]; then
      [[ "$2" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]+[a-zA-Z0-9]$ ]] || { echo 'Укажите корректный домен без протокола' >&2; exit 1; }
      set_env_var "APP_DOMAIN" "$2"
      dc_cmd up -d --no-deps --no-build --pull never caddy backend
      echo -e "${GREEN}✓ Домен изменен на: $2${NC}"
    else
      cmd_domain
    fi
    ;;
  import)
    shift
    run_importer "$@"
    ;;
  logs) cmd_logs "$2" ;;
  help|--help|-h)
    echo -e "Использование: cargona [команда]"
    echo -e "Команды:"
    echo -e "  status           - Показать статус системы и контейнеров"
    echo -e "  doctor           - Проверить зависимости и доступность Docker"
    echo -e "  admin:reset      - Сбросить email/пароль Супер-Админа"
    echo -e "  limit [N]        - Установить лимит организаций"
    echo -e "  loyalty          - Управление программой лояльности (NOOR CLUB)"
    echo -e "  backup           - Создать резервную копию базы"
    echo -e "  backup:restore   - Восстановить базу из бэкапа"
    echo -e "  offsite:configure - Настроить зашифрованные копии в B2"
    echo -e "  offsite:install-restic - Установить Restic на Debian/Ubuntu с подтверждением"
    echo -e "  offsite:init|run|enable|disable|status|list|check|prune - Автобэкапы"
    echo -e "  offsite:restore ID - Скачать копию отдельно от рабочей базы"
    echo -e "  monitor:configure|enable|disable|run|status - Мониторинг и уведомления"
    echo -e "  rehearse DIR IMAGE - Пробное восстановление в изолированной среде"
    echo -e "  tools:update [SHA] - Выбрать версию CLI и обновить скрипты"
    echo -e "  migration:status|inspect|trial|rehearse|apply - JSON → PostgreSQL"
    echo -e "  update [SHA]     - Выбрать опубликованную версию Docker-образов"
    echo -e "  rollback:list    - Список сохранённых версий и бэкапов"
    echo -e "  rollback ID      - Вернуть образы приложения, сохранив актуальную базу"
    echo -e "  restart          - Перезапустить контейнеры"
    echo -e "  domain [domain]  - Изменить домен и перевыпустить SSL"
    echo -e "  import [flags]   - Умный импорт из MongoDB или JSON (--mongo / --dir)"
    echo -e "  logs [service]   - Смотреть логи в реальном времени"
    ;;
  "") interactive_menu ;;
  *)
    echo -e "${RED}Неизвестная команда: $1${NC}. Используйте './cargona help' для списка команд."
    exit 1
    ;;
esac
